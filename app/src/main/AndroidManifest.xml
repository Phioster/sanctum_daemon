<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Android TV support. Both are `required="false"` so this stays one APK: a phone has no leanback
      launcher and a TV has no touchscreen, and neither may exclude the other from installing.
      Declaring the touchscreen optional is what makes the app installable on a TV device at all.
    -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- So getLaunchIntentForPackage can see the companion apps on Android 11+. -->
    <queries>
        <package android:name="org.jellyfin.mobile" />
        <package android:name="dev.jdtech.jellyfin" />
        <package android:name="dev.seerr.mobileapp" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="Sanctumd"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Sanctumd">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The television front door. LEANBACK_LAUNCHER is what an Android TV launcher lists, and
          MainActivity deliberately does not declare it — so the TV shows only this activity and a
          phone shows only MainActivity, from the same installed package.

          configChanges keeps the activity alive across the size/orientation churn a TV emits when
          the player takes over the screen; without it playback state is destroyed mid-file.
        -->
        <activity
            android:name=".ui.tv.TvActivity"
            android:exported="true"
            android:banner="@drawable/tv_banner"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Offline media downloads: streams Jellyfin files to private storage. -->
        <service
            android:name=".service.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Background music playback (MediaSession + media-style notification). -->
        <service
            android:name=".service.MusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Live push: keeps a streaming connection to the user's ntfy topic open. -->
        <service
            android:name=".notify.NtfyStreamService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Receiving live notifications from a self-hosted ntfy server" />
        </service>

        <!-- Restart the live-push stream after a reboot. -->
        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Homescreen widget: one-tap HTTP shortcut buttons. -->
        <receiver
            android:name=".widget.ShortcutsWidgetReceiver"
            android:label="Sanctumd Shortcuts"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shortcuts_widget_info" />
        </receiver>

        <!-- 1×1 icon widget: fires a single chosen HTTP shortcut. -->
        <receiver
            android:name=".widget.ShortcutIconWidgetReceiver"
            android:label="Sanctumd Shortcut (icon)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shortcut_icon_widget_info" />
        </receiver>

        <!-- Homescreen widget: every service's status at a glance. -->
        <receiver
            android:name=".widget.StatusWidgetReceiver"
            android:label="Sanctumd Status"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/status_widget_info" />
        </receiver>

        <!-- Homescreen widget: what's half-watched on Jellyfin. -->
        <receiver
            android:name=".widget.ResumeWidgetReceiver"
            android:label="Sanctumd Continue Watching"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/resume_widget_info" />
        </receiver>

        <!-- Homescreen widget: upcoming releases across Radarr/Sonarr/Lidarr (agenda list). -->
        <receiver
            android:name=".widget.CalendarWidgetReceiver"
            android:label="Sanctumd Upcoming"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <!-- 1×1 stat tile: online/total services at a glance. -->
        <receiver
            android:name=".widget.StackHealthWidgetReceiver"
            android:label="Sanctumd Health"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/health_tile_widget_info" />
        </receiver>

        <!-- 1×1 stat tile: NZBGet download queue size. -->
        <receiver
            android:name=".widget.QueueTileWidgetReceiver"
            android:label="Sanctumd Queue"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/queue_tile_widget_info" />
        </receiver>

        <!-- 1×1 stat tile: Jellyseerr pending requests. -->
        <receiver
            android:name=".widget.SeerrTileWidgetReceiver"
            android:label="Sanctumd Requests"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/seerr_tile_widget_info" />
        </receiver>

        <!-- 1×1 stat tile: Jellyfin library size (movies + series). -->
        <receiver
            android:name=".widget.LibraryTileWidgetReceiver"
            android:label="Sanctumd Library"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/library_tile_widget_info" />
        </receiver>

        <!-- Picks which shortcut the 1×1 icon widget fires (shown when placed). -->
        <activity
            android:name=".widget.ShortcutWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Sanctumd">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Homescreen widget: quick-action buttons for one chosen service. -->
        <receiver
            android:name=".widget.QuickActionsWidgetReceiver"
            android:label="Sanctumd Quick Actions"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_actions_widget_info" />
        </receiver>

        <!-- Picks which service the quick-actions widget controls (shown when placed). -->
        <activity
            android:name=".widget.QuickActionsConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Sanctumd">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Shares the encrypted config export from the cache dir. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
