<?xml version="1.0" encoding="utf-8"?>
<!-- Sanctumd launcher foreground: the sanctum gateway (pointed arch) guarding a
     watchful daemon eye. Matrix green on near-black; dim inner details. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- inner arch line (dim, depth) -->
    <path
        android:pathData="M41,80 L41,53 C41,40 47,33 54,29 C61,33 67,40 67,53 L67,80"
        android:strokeColor="#1F7A34"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round" />

    <!-- steps (dim) -->
    <path
        android:pathData="M42,85 L66,85 M36,89 L72,89"
        android:strokeColor="#1F7A34"
        android:strokeWidth="3"
        android:strokeLineCap="round" />

    <!-- outer arch (bright) -->
    <path
        android:pathData="M36,80 L36,52 C36,38 44,30 54,26 C64,30 72,38 72,52 L72,80"
        android:strokeColor="#00FF41"
        android:strokeWidth="3"
        android:strokeLineJoin="round" />

    <!-- base feet (bright) -->
    <path
        android:pathData="M31,80 L41,80 M67,80 L77,80"
        android:strokeColor="#00FF41"
        android:strokeWidth="3" />

    <!-- eye glow (fake bloom) -->
    <path
        android:pathData="M40,53 Q54,44 68,53 Q54,62 40,53 Z"
        android:strokeColor="#00FF41"
        android:strokeWidth="6"
        android:strokeAlpha="0.22" />

    <!-- dim eye-corner accents -->
    <path
        android:pathData="M35,53 L31,53 M73,53 L77,53"
        android:strokeColor="#2F9E46"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />

    <!-- eye outline (bright) -->
    <path
        android:pathData="M40,53 Q54,44 68,53 Q54,62 40,53 Z"
        android:strokeColor="#00FF41"
        android:strokeWidth="2.6"
        android:strokeLineJoin="round" />

    <!-- pupil glow -->
    <path
        android:pathData="M50,53 a4,8 0 1,0 8,0 a4,8 0 1,0 -8,0"
        android:fillColor="#00FF41"
        android:fillAlpha="0.25" />

    <!-- slit pupil (bright) -->
    <path
        android:pathData="M51.6,53 a2.4,5.8 0 1,0 4.8,0 a2.4,5.8 0 1,0 -4.8,0"
        android:fillColor="#00FF41" />
</vector>
