<?xml version="1.0" encoding="utf-8"?>
<!--
  Android TV banner (16:9, shown in the leanback launcher).

  The launcher renders this at 320×180 dp, so it is built from the app's own artwork rather than a
  bitmap: `ic_launcher_background` is the radial-gradient panel the icon already uses, and the
  launcher foreground sits inset on top of it. Vector drawables carry no text, so there is no
  wordmark here — the launcher prints the app label underneath.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item
        android:drawable="@drawable/ic_launcher_fg"
        android:gravity="center"
        android:width="150dp"
        android:height="150dp" />
</layer-list>
